rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthorizedAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'emkayvisuals@gmail.com' ||
        request.auth.token.email.lower() == 'nuru28893@gmail.com'
      );
    }

    match /portfolio/content {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
    match /briefs/{document} {
      allow create: if true;
      allow read, update, delete: if isAuthorizedAdmin();
    }
    match /projectBriefs/{document} {
      allow create: if true;
      allow read, update, delete: if isAuthorizedAdmin();
    }
    match /analytics/{document} {
      allow read, delete: if isAuthorizedAdmin();
      allow create, update: if isAuthorizedAdmin() || document == 'summary';
    }
    match /media/{document} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
    match /galleryLikes/{itemId} {
      allow read: if true;
      allow create: if (request.resource.data.count == 1) || isAuthorizedAdmin();
      allow update: if (
        (
          request.resource.data.count == resource.data.count + 1 ||
          request.resource.data.count == resource.data.count - 1
        ) &&
        request.resource.data.count >= 0
      ) || isAuthorizedAdmin();
      allow delete: if isAuthorizedAdmin();

      match /records/{visitorId} {
        allow read: if true;
        allow create: if request.resource.data.visitorId == visitorId;
        allow delete: if resource.data.visitorId == visitorId || isAuthorizedAdmin();
        allow update: if false;
      }
    }
  }
}
