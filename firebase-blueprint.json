{
  "entities": {
    "PortfolioContent": {
      "title": "PortfolioContent",
      "description": "Portfolio content document stored in Firestore",
      "type": "object",
      "properties": {
        "brand": { "type": "object" },
        "hero": { "type": "object" },
        "stats": { "type": "array" },
        "services": { "type": "array" },
        "projects": { "type": "array" },
        "about": { "type": "object" },
        "testimonials": { "type": "array" },
        "socials": { "type": "object" },
        "contact": { "type": "object" },
        "manipulationGallery": { "type": "object" }
      }
    },
    "ProjectBrief": {
      "title": "ProjectBrief",
      "description": "Incoming project brief submitted by a visitor",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "service": { "type": "string" },
        "budget": { "type": "string" },
        "deadline": { "type": "string" },
        "message": { "type": "string" },
        "referenceLink": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "MediaItem": {
      "title": "MediaItem",
      "description": "Converted WebP image stored in its own Firestore document",
      "type": "object",
      "properties": {
        "base64": { "type": "string" },
        "contentType": { "type": "string" },
        "name": { "type": "string" },
        "sizeBytes": { "type": "number" },
        "createdAt": { "type": "string" }
      }
    },
    "GalleryLikeSummary": {
      "title": "GalleryLikeSummary",
      "description": "Aggregated like count for a manipulation gallery artwork",
      "type": "object",
      "properties": {
        "count": { "type": "number" },
        "itemId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["count"]
    },
    "GalleryLikeRecord": {
      "title": "GalleryLikeRecord",
      "description": "Record of a like placed by an anonymous visitor",
      "type": "object",
      "properties": {
        "visitorId": { "type": "string" },
        "itemId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["visitorId"]
    }
  },
  "firestore": {
    "/portfolio/content": {
      "schema": { "$ref": "#/entities/PortfolioContent" },
      "description": "Main portfolio content managed via admin panel"
    },
    "/briefs/{briefId}": {
      "schema": { "$ref": "#/entities/ProjectBrief" },
      "description": "Submitted project briefs"
    },
    "/media/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaItem" },
      "description": "Converted WebP images stored as individual documents"
    },
    "/galleryLikes/{itemId}": {
      "schema": { "$ref": "#/entities/GalleryLikeSummary" },
      "description": "Aggregate like count per gallery artwork"
    },
    "/galleryLikes/{itemId}/records/{visitorId}": {
      "schema": { "$ref": "#/entities/GalleryLikeRecord" },
      "description": "Individual visitor like record"
    }
  }
}
